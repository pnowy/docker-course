# DOBRZE - wariant env: sekret jako zmienna środowiskowa widoczna wyłącznie
# w obrębie tej jednej instrukcji RUN. To jest to, co ludzie próbują osiągnąć
# przez ENV, tylko zrobione poprawnie.
#
#   export GITHUB_TOKEN=ghp_TAJNY_TOKEN_1234567890
#   docker build --secret id=gh_token,env=GITHUB_TOKEN -t bs-secret-env -f Dockerfile_secret_env .
#
#   docker run --rm bs-secret-env cat /wynik.txt   # sekret BYŁ dostępny przy budowaniu
#   docker run --rm bs-secret-env env | grep -i token   # nic - nie ma go w kontenerze
#   docker inspect bs-secret-env --format '{{json .Config.Env}}'
FROM alpine:3.24.1

# Zmienna GITHUB_TOKEN istnieje tylko na czas tego RUN. Do obrazu trafia sam
# wynik - długość tokenu, bez jego wartości.
RUN --mount=type=secret,id=gh_token,env=GITHUB_TOKEN,required=true \
    echo "token był dostępny przy budowaniu, długość: ${#GITHUB_TOKEN} znaków" \
        > /wynik.txt

CMD ["cat", "/wynik.txt"]
