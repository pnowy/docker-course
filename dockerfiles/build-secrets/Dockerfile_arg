FROM node:24.20.0-alpine

ENV NODE_ENV=production
WORKDIR /app

ARG NPM_TOKEN

COPY package.json package-lock.json ./

# Kasowanie pliku na końcu niczego nie ratuje z dwóch powodów:
# token jest już w metadanych warstwy (powyżej), a gdyby rm był w osobnej
# instrukcji RUN, sam plik zostałby w warstwie niżej.
RUN echo "//registry.npmjs.org/:_authToken=${NPM_TOKEN}" > .npmrc && \
    npm ci --omit=dev && \
    rm .npmrc

COPY app.js ./

EXPOSE 3000
CMD ["node", "app.js"]
